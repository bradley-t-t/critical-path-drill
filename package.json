{
  "name": "critical-path-drill",
  "version": "1.1.3",
  "private": true,
  "description": "A ten-lesson desktop course on working out a project schedule by hand",
  "license": "MIT",
  "author": "Trenton Taylor",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "verify": "electron test/verify.js",
    "icon": "python3 scripts/make-icon.py",
    "dist": "electron-builder",
    "dist:all": "electron-builder --mac --arm64 --x64"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.taylorurl.criticalpathdrill",
    "productName": "Critical Path Drill",
    "copyright": "Copyright © 2026 Trenton Taylor",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "mac": {
      "category": "public.app-category.education",
      "identity": null,
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-win-x64-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-x64-portable.${ext}"
    }
  }
}
